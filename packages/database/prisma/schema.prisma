generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DATABASE_URL/DIRECT_URL: standard Postgres connection strings. Both
  // vars are kept for parity with hosted-Postgres setups that need a
  // separate pooled-vs-direct connection (e.g. via PgBouncer) — for a
  // plain local/VPS Postgres instance, both can point at the same
  // connection string.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  AGENT
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  passwordHash   String

  memberships    Membership[]
  refreshTokens  RefreshToken[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Business {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique

  members       Membership[]
  usage         BusinessUsage?

  // "regular" | "repair" -- gates repair-only features (Order Management)
  // in the client dashboard nav. Set by platform admin in the mother
  // dashboard's Clients panel.
  type          String   @default("regular")

  // How many agent (handoff-team) logins this business is allowed to
  // create for itself under Client Access -- 0 means the feature isn't
  // enabled for them yet. Set by platform admin only; the client's own
  // Agents panel enforces this but never raises it.
  maxAgents     Int      @default(0)

  // Subscription fields (manual management by admin)
  subscriptionPlanName  String?
  subscriptionFee       Float?
  subscriptionCurrency  String    @default("BDT")
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  subscriptionActive    Boolean   @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Usage tracking for billing and plan limits
model BusinessUsage {
  id              String    @id @default(cuid())
  businessId      String    @unique
  chatCount       Int       @default(0)  // Total AI messages this period
  orderCount      Int       @default(0)  // Orders collected this period
  lastResetAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Membership {
  id           String     @id @default(cuid())

  userId       String
  businessId   String

  role         Role

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt    DateTime   @default(now())

  @@unique([userId, businessId])
}

model RefreshToken {
  id          String    @id @default(cuid())

  token       String    @unique

  userId       String

  expiresAt    DateTime

  createdAt    DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum HandoffStatus {
  BOT
  PENDING
  HUMAN
}

model Conversation {
  id                 String        @id
  businessId         String
  userId             String

  // "website" | "messenger" | "instagram" | "whatsapp" — which channel
  // this conversation came in through. Needed for the unified All Chats
  // inbox (per-conversation channel icon/label/filter) and for routing a
  // human agent's handoff reply back out through the right channel's own
  // Send API instead of just saving it to the database.
  channel            String        @default("website")
  // The customer's platform-specific id (Messenger PSID / IG-scoped id /
  // WhatsApp wa_id) — null for website conversations. This is where a
  // human agent's reply actually gets sent on that channel's Send API.
  externalUserId     String?

  handoffStatus      HandoffStatus @default(BOT)
  handoffReason      String?
  handoffSummary     String?
  handoffRequestedAt DateTime?
  // Which ClientAccount (isAgent) is on the hook for this handoff --
  // set once by ConversationService.requestHandoff's auto-assignment
  // (least-busy online agent), plain string reference like every other
  // businessId-scoped field here, not a Prisma relation. Null until an
  // agent exists and is online to receive it, or if the business has
  // no agent feature enabled at all.
  assignedAgentId    String?

  // The 5 order fields once the AI has collected all of them and is
  // waiting on the customer's confirmation (see ChatService's
  // ORDER_PENDING marker) — stored here, not in message history, so a
  // bare "yes"/"thik ache" reply can finalize the order deterministically
  // in code without asking the AI to re-derive everything from a chat
  // transcript again (that re-derivation was the real bug: a generic
  // confirmation message's own retrieval pass could pull in unrelated
  // knowledge-base chunks and derail the model into losing the order
  // context entirely, confirmed live). Cleared once the order is created
  // or once the customer says something that isn't a plain confirmation.
  pendingOrder       Json?

  // Training Arena sessions (dashboard tab where an admin deliberately
  // provokes/corrects the AI, e.g. triggers a handoff then argues with
  // it) — set once at creation, never changes. Two effects: ChatService
  // never applies the "already connected to a human agent" block to a
  // training conversation (the whole point is to keep talking to the AI
  // AFTER it hands off, to correct that exact behavior), and the real
  // Handoffs queue excludes these so a training session's deliberately-
  // provoked handoff doesn't show up as something an agent must attend to.
  isTraining           Boolean @default(false)
  // Not currently collected anywhere in the app (no rating UI exists) —
  // column added for forward-compatibility so the training pipeline's
  // schema doesn't need another migration the day a rating widget
  // does get built.
  userFeedbackRating   Int?

  messages           Message[]
  conversationReview ConversationReview?
  conversationTags   ConversationTag[]
  notes              ConversationNote[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([businessId, channel])
  @@index([businessId, createdAt])
  @@index([businessId, assignedAgentId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  // Which AI provider actually generated this assistant reply ("groq",
  // "handoff", "canned", "cached", etc.) — admin/backend visibility only,
  // shown as a subline in the dashboard's conversation view. Never sent
  // to the customer-facing widget. Null for user/agent messages.
  provider       String?
  // Which knowledge-base source(s) (crawled page URL / uploaded filename)
  // this answer was actually retrieved from — same admin-only visibility
  // as `provider`, shown in Training Arena and the backend admin's chat
  // view so a wrong/missing answer can be traced back to exactly what
  // the AI read (or didn't). Array of {label, score, embeddingProvider},
  // most relevant first. Null for user/agent messages or answers with no
  // retrieval (canned greeting, cache hit with no fresh retrieval, etc.).
  sources        Json?
  // Top retrieval score for this answer (0-1, how well the knowledge
  // base actually matched the question) — same admin-only visibility as
  // provider/sources, shown behind an "i" info affordance next to the
  // message so "why did it answer this way" is answerable without
  // re-running the question. Null for user/agent messages.
  confidence     Float?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedback       MessageFeedback?
  messageTags    MessageTag[]

  createdAt      DateTime @default(now())
}

// Per-message QA verdict from whoever is running the Chat Demo tab as a
// test/QA tool — not customer-facing. One row per message (upsert on
// re-submit, not a history of every click), since only the CURRENT
// verdict matters for what the training pipeline reads. The training
// pipeline treats a fail (with its note) as a strong, explicit signal
// about exactly what was wrong with that specific answer — stronger
// than its own judgment of the same exchange.
model MessageFeedback {
  id         String   @id @default(cuid())
  messageId  String   @unique
  businessId String

  // "pass" | "fail"
  verdict    String
  note       String?

  message    Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, verdict])
}

// Intercom-style internal note — an aside a staff member leaves on a
// conversation for teammates, never sent to the customer and never
// mixed into Message (which is the actual on-channel thread, including
// agent replies that DO go out to the customer over that channel's Send
// API). Rendered in its own section of the Inbox detail panel, not as a
// bubble in the message thread. author is a free-text label (this
// platform's dashboards have no per-staff-member login identity beyond
// the shared admin/client account — see CLAUDE.md's "no auth" note —
// so there's no userId to attribute it to).
model ConversationNote {
  id             String   @id @default(cuid())
  conversationId String
  businessId     String
  author         String
  body           String

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

model CrawlTarget {
  id             String    @id @default(cuid())
  businessId     String
  url            String

  status         String    @default("idle")
  pagesEstimated Int?
  pagesDone      Int       @default(0)
  // Phase-2 (embedding) progress, separate from pagesDone (phase-1
  // crawling progress) — status distinguishes which phase pagesDone vs
  // pagesIndexed is currently meaningful for: "crawling" -> pagesDone is
  // live, "embedding" -> pagesIndexed is live, "done" -> both final.
  pagesIndexed   Int       @default(0)

  lastCrawledAt  DateTime?
  lastPageCount  Int?
  lastChunkCount Int?
  lastError      String?

  // Auto-heal retry/backoff state. lastCrawledAt only updates on a
  // *successful* crawl, so it can't tell auto-heal "how long has this
  // target been sitting broken" — updatedAt does. nextRetryAt gates when
  // auto-heal is allowed to retry a status:"error" target again;
  // retryCount drives the backoff (min(1h * 2^retryCount, 24h)), reset
  // to 0 on the next successful crawl.
  retryCount     Int       @default(0)
  nextRetryAt    DateTime?

  // Resumable BFS crawl state (queue/visited/path-variant-counts, JSON
  // serialized) — a large site can't finish crawling inside one
  // serverless invocation's execution-time cap no matter how that cap is
  // tuned, so runCrawl() processes one bounded batch per call and
  // persists the rest here to pick back up next time. Null when no
  // crawl is currently mid-flight (either never started, or genuinely
  // finished this round).
  frontierJson   String?

  // A one-time-derived, per-site regex extraction pattern (see
  // TabularExtractionClient.deriveTemplate) -- lets the bulk of a crawl's
  // product pages be extracted with plain regex instead of one Groq call
  // per page, while staying generic across every client's own site
  // layout (the pattern itself is derived from THIS site's real sample
  // pages, not hardcoded). Null until enough product-page samples have
  // been seen to derive one, or if derivation was tried and failed
  // (falls back to per-page LLM extraction unconditionally in that case
  // -- see CrawlerService.indexPhase).
  extractionTemplate Json?
  // Running tally of individual product pages that have gone through a
  // REAL per-page LLM extraction so far this crawl -- gates when the
  // template above is allowed to be derived (owner's explicit call: at
  // least 15% of this site's pages need to have been genuinely
  // extracted first, so the derived pattern is backed by real breadth,
  // not a token handful). templateSampleTexts holds up to
  // MAX_TEMPLATE_SAMPLES of those pages' raw text (the actual input to
  // the one derivation call) -- capped independently of the running
  // count, which can keep growing past that cap while waiting for the
  // 15% threshold.
  templateSampleCount Int   @default(0)
  templateSampleTexts Json?

  updatedAt      DateTime  @default(now()) @updatedAt

  createdAt      DateTime  @default(now())

  @@unique([businessId, url])
}

// Raw fetched page text, written during the crawl phase and consumed
// (then deleted) during the indexing phase — the durable handoff between
// the two so "crawl everything, THEN embed everything, THEN build the
// CSV" survives a process restart between phases. Without this, indexing
// held only in memory between phases would silently lose every crawled-
// but-not-yet-indexed page if the process died before reaching phase 2,
// even though the crawl itself had already marked those URLs visited.
model CrawledPage {
  id            String   @id @default(cuid())
  crawlTargetId String
  url           String
  text          String
  imageUrl      String?
  contentHash   String
  fetchedAt     DateTime @default(now())

  @@unique([crawlTargetId, url])
  @@index([crawlTargetId])
}

// One row per invocation of the auto-heal job (cron every 30min, or the
// dashboard's manual "Run now" button) — mirrors PipelineRun's shape but
// fixes its gap: PipelineRun has no status/error columns, so a crash
// mid-run leaves finishedAt null forever with nothing recorded about
// what happened. This table always writes a terminal status.
model AutoHealRun {
  id                  String    @id @default(cuid())

  // "cron" | "manual"
  triggeredBy         String

  startedAt           DateTime  @default(now())
  finishedAt          DateTime?

  // "running" | "succeeded" | "failed"
  status              String    @default("running")
  error               String?

  businessesChecked   Int       @default(0)
  providersBackfilled Int       @default(0)
  crawlTargetsRetried Int       @default(0)

  @@index([startedAt])
}

// Per (business, embedding provider) retry/backoff state for auto-heal's
// coverage-gap backfill attempts. Needed once checks run every 30 minutes
// instead of once/day — without this, a provider that's still broken
// after one attempt would get re-attempted on every single 30-minute
// check instead of backing off. Same formula as CrawlTarget's retry
// fields: min(1h * 2^retryCount, 24h).
model EmbeddingBackfillCooldown {
  businessId  String
  provider    String
  retryCount  Int       @default(0)
  nextRetryAt DateTime?
  updatedAt   DateTime  @default(now()) @updatedAt

  @@id([businessId, provider])
}

// Replaces storage/embeddings/knowledge.json, which corrupted under
// concurrent writes (read-whole-file/mutate/write-whole-file with no
// row-level atomicity). One row per (document chunk x embedding
// provider) vector. businessId/embeddingProvider are the only two fields
// ever filtered on directly (search/coverageStatus/backfill), so they're
// dedicated columns; everything else (contentHash, pageStatus, url,
// filename, chunkIndex, etc.) lives in metadata.
//
// embeddingVec mirrors `embedding` in pgvector's native type (both
// providers currently embed at 1024 dims — see
// packages/database/sql/pgvector-setup.sql for the one-time setup this
// needs: CREATE EXTENSION, an HNSW index, and a trigger that keeps this
// column in sync with `embedding` automatically on every write, so no
// app code has to touch it). Declared Unsupported so `prisma db push`
// leaves it alone instead of trying to manage a type it can't represent
// natively — see that same SQL file when setting this up on a new
// Postgres (VPS move, dev machine, etc.): run it once after `db push`.
model VectorRecord {
  id                String                      @id
  documentId        String
  chunkId           String
  text              String
  embedding         Float[]
  embeddingVec      Unsupported("vector(1024)")?

  businessId        String?
  embeddingProvider String?
  metadata          Json?

  createdAt         DateTime @default(now())

  @@index([businessId, embeddingProvider])
  @@index([documentId])
}

// Every save (full update or incremental append) inserts a new row —
// never mutates an old one. That makes the table both "current config"
// (latest row per businessId) and "full history" (every row) at the
// same time, with no separate audit-log table to keep in sync.
//
// businessId "__platform__" is the mother dashboard's default. A client
// with no rows of their own inherits whatever the latest "__platform__"
// row says; the moment they save their own change, they get their own
// row and are independent of the platform default from then on.
model AiConfigVersion {
  id           String   @id @default(cuid())

  businessId   String   @default("__platform__")

  systemPrompt String
  handoffFloor Float
  historyTurns Int
  temperature  Float    @default(0.1)

  // "auto" (match whatever register the customer's latest message used —
  // the original, still-default behavior) | "english" | "bangla" |
  // "banglish" — when locked, the AI always replies in this language
  // regardless of what language the customer writes in.
  languageMode String   @default("auto")

  // Vision mode for customer-sent photos: "current" uses Gemini to
  // describe the image as text before sending to any provider (AI sees
  // a text description), "mimo" sends the raw image to MiMo-V2.5 via
  // OpenRouter so the AI sees the actual pixels.
  visionMode   String   @default("current")

  // Provider-tuning parameters, overriding all AI providers uniformly for
  // this business. maxTokens replaces the old hardcoded ANSWER_MAX_TOKENS
  // constant — every business now controls its own answer length. The
  // rest are nullable: null means "let the provider use its own default"
  // rather than forcing every provider to the same numeric default.
  maxTokens        Int     @default(1024)
  topP             Float?
  frequencyPenalty Float?
  presencePenalty  Float?
  // Comma-separated — Postgres text array would need a migration-visible
  // type change for a field this rarely used; a plain string parsed at
  // the call site is the smaller diff.
  stopSequences    String?
  seed             Int?

  changeType   String   // "seed" | "update" | "append" | "language" | "parameters"
  note         String?

  createdAt    DateTime @default(now())

  @@index([businessId, createdAt])
}

// Dashboard "activate provider" keys, persisted so they survive a
// restart — the whole point of a dashboard toggle is that it's durable,
// not just a live in-memory patch that silently reverts to whatever's
// in .env the next time the process restarts. One row per (kind,
// providerId); activating again just overwrites it (upsert), no history
// needed here unlike AiConfigVersion.
//
// "kind" separates AI chat providers from embedding providers — both
// systems can have a provider literally named "gemini" or "mistral" at
// the same time (same company, different endpoint/API key), and they
// must never collide or overwrite each other.
model ProviderApiKey {
  id         String   @id @default(cuid())
  kind       String   @default("ai")
  providerId String
  apiKey     String

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([kind, providerId])
}

// Groq key pool for tabular extraction (crawl/upload table extraction —
// see TabularExtractionClient/TemplateExtractor), separate from
// ProviderApiKey above: that model is one key PER provider id, but
// extraction genuinely needs several Groq keys rotating together (a
// single key's real limit turned out to be Groq's 100,000-tokens/DAY free
// tier, not per-minute -- KeyRotator hops to the next key the moment one's
// daily quota is hit). No uniqueness beyond id -- just a flat list an
// operator can add to or remove from via the dashboard instead of hand-
// editing GROQ_EXTRACTION_API_KEY_N env vars and asking for a code change
// every time. Read once at process boot (container.ts) -- adding/removing
// a key here takes effect on the next restart, not instantly.
model ExtractionApiKey {
  id        String   @id @default(cuid())
  apiKey    String
  label     String?

  createdAt DateTime @default(now())
}

// Dashboard's provider on/off toggle, persisted so it survives a
// restart — same reasoning as ProviderApiKey above (activating a key
// only ever patched the running AIManager/EmbeddingManager in memory).
// Only rows for EXPLICITLY DISABLED providers need to exist — a provider
// with no row here is enabled by default, matching AIManager's own
// in-memory default.
model ProviderState {
  kind       String
  providerId String
  enabled    Boolean  @default(true)
  updatedAt  DateTime @default(now()) @updatedAt

  @@id([kind, providerId])
}

// A user-added AI chat provider not in the hardcoded catalog — any
// OpenAI-compatible /chat/completions API (which covers the overwhelming
// majority of newly-released providers, same shape already used by
// OpenRouter/Cerebras/Mistral) can be added this way without writing a
// new adapter package for every new vendor. id doubles as the provider
// name AIManager registers it under.
model CustomProvider {
  id        String   @id @default(cuid())
  label     String
  baseUrl   String
  model     String
  apiKey    String
  createdAt DateTime @default(now())
}

// One shared light/dark preference for the whole dashboard shell —
// deliberately a single row, not per-user/per-browser: the owner wants
// the toggle to be "universal for all users", not a personal localStorage
// setting that could show each operator a different look.
model DashboardTheme {
  id        String   @id @default("singleton")
  mode      String   @default("dark")
  updatedAt DateTime @updatedAt
}

// A human's manual decision on one conversation for the "Chat Learning"
// workflow — is this chat worth training on at all ("add"/"drop"), and
// did the AI actually handle it well ("pass"/"fail" + free-text note).
// Nothing here is ever written by an LLM — replaces the old automatic
// ChatAnalysis verdict entirely. analyzedAt is stamped once this chat
// has been included in a completed TrainingAnalysisRun, so the UI can
// show "already analyzed" without forcing a re-run.
model ConversationReview {
  id             String    @id @default(cuid())

  conversationId String    @unique
  businessId     String

  decision       String?   // "add" | "drop" | null = undecided
  qaVerdict      String?   // "pass" | "fail" | null
  qaNote         String?
  analyzedAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([businessId, decision])
}

// One row per "Run AI Analysis" click in Chat Learning — a human curates
// a batch of chats (ConversationReview.decision = "add") plus their QA
// feedback, then this sends the whole batch to Gemini in one call and
// stores the resulting findings report. Read-only: nothing here ever
// writes to AiConfigVersion — the human reads this and edits the AI
// Brain prompt themselves.
model TrainingAnalysisRun {
  id              String   @id @default(cuid())

  businessId      String
  // Comma-separated conversation ids included in this run — same
  // convention as AiConfigVersion.stopSequences (small scale, avoids a
  // migration-visible array type change for a rarely-queried field).
  conversationIds String
  report          String

  createdAt       DateTime @default(now())

  @@index([businessId, createdAt])
}

// Per-client channel connections (website/messenger/instagram/whatsapp) —
// one row per (business, channel). Absence of a row means "not
// connected"; the dashboard shows that as a plain state rather than
// needing a separate status column for it. Disconnecting deletes the
// row (not a soft-delete) — status is kept anyway so a future "error"
// state (e.g. Meta revoked the token) doesn't need a schema change.
model ChannelConnection {
  id            String   @id @default(cuid())
  businessId    String
  channel       String
  status        String   @default("connected")

  // Page ID / IG Business Account ID / WhatsApp phone_number_id — how an
  // inbound webhook payload gets matched back to a business.
  externalId    String
  externalLabel String
  accessToken   String
  config        Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([businessId, channel])
  @@index([channel, externalId])
}

// One row per channel, platform-wide (not per client) — the Meta
// Developer App credentials required before any client can OAuth-connect
// Messenger/Instagram. WhatsApp's manual-entry connect flow doesn't need
// appId/appSecret, only webhookVerifyToken, but shares this table since
// it's still one place to configure every channel's platform-level setup.
model ChannelAppCredential {
  channel            String   @id
  appId              String   @default("")
  appSecret          String   @default("")
  webhookVerifyToken String   @default("")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Intercom-style conversation/message tagging. businessId "__platform__"
// is a tag visible to and usable by every client (mother-managed,
// mirrors AiConfigVersion's platform-default convention); any other
// businessId is a tag private to that one client. isFunnelStage +
// funnelOrder let a subset of tags double as an ordered sales pipeline
// (Lead -> Interested -> Sold) for the client dashboard's funnel/
// conversion-rate charts — a plain tag just leaves these unset.
model Tag {
  id            String   @id @default(cuid())
  label         String
  color         String?
  businessId    String   @default("__platform__")
  isFunnelStage Boolean  @default(false)
  funnelOrder   Int?
  createdAt     DateTime @default(now())

  conversationTags ConversationTag[]
  messageTags      MessageTag[]
  orderTags        OrderTag[]

  @@unique([businessId, label])
  @@index([businessId, isFunnelStage])
}

// Conversation-level tag assignment. source distinguishes an AI-assigned
// tag (from ConversationTaggingPipeline) from one a human added by hand
// via the inline "+ tag" control — both render as chips, visually
// distinguished. The unique constraint is what guarantees a tag can
// never be double-counted for one conversation even if both the AI and
// a human apply the same tag.
model ConversationTag {
  id             String   @id @default(cuid())
  conversationId String
  tagId          String
  source         String   // "ai" | "manual"

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())

  @@unique([conversationId, tagId])
  @@index([tagId])
}

// Message-level tag assignment — the finer-grained companion to
// ConversationTag, applied via the hover-to-tag control on a single
// message bubble. Never rolled into the headline conversation-level
// analytics; only shown as a "which message triggered this" drill-down.
model MessageTag {
  id        String   @id @default(cuid())
  messageId String
  tagId     String
  source    String   // "ai" | "manual"

  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([messageId, tagId])
  @@index([tagId])
}

// A client login — separate from the orphaned User/Membership models
// above (those were an abandoned platform-wide auth attempt). One
// business can have several of these (different staff, different
// usernames), all landing on the same /dashboard/{businessId}. Created
// and managed entirely from the mother dashboard's Client Access panel.
model ClientAccount {
  id           String    @id @default(cuid())
  // Nullable only for an isAdmin account -- a real client login always
  // has one. Enforced in ClientAuthService.create, not here.
  businessId   String?
  username     String    @unique
  passwordHash String
  // Reversibly encrypted (AES-256-GCM, server-side key) copy of the
  // current password -- kept alongside the one-way passwordHash used
  // for actual login verification, purely so the platform admin and a
  // business owner can reveal a login's current password in their own
  // "show password" UI. Null for a login whose password was set before
  // this field existed; it backfills the next time the password changes.
  passwordEncrypted String?
  disabled     Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  // Which client-dashboard tabs (nav item ids, e.g. "knowledge",
  // "allchats") this account is allowed to see -- null means every tab
  // (the pre-existing, unrestricted default, so accounts created before
  // this feature keep working exactly as before). An admin browsing the
  // same dashboard via admin_session is never restricted by this --
  // only a real client login is. Meaningless when isAdmin is true (an
  // admin account always sees every panel on every dashboard).
  allowedPanels Json?
  // Full platform access, same as the single hardcoded admin/admin
  // login (see admin-session.ts) -- this is an ADDITIONAL way to reach
  // that same access level with its own named, disable/delete-able
  // credential, not a lesser tier. See proxy.ts for how a session with
  // this flag set is allowed onto "/dashboard" (mother) and any
  // "/dashboard/{businessId}", exactly like the fixed admin identity.
  isAdmin      Boolean   @default(false)
  // "owner" | "staff" | null -- which role preset (see RolePreset) this
  // login was created from, chosen once in the create-login dropdown.
  // Purely a label for display/audit; allowedPanels is a one-time copy
  // of that preset at creation time, not a live link back to it.
  role         String?

  // A business-scoped handoff-team member, created by the business
  // OWNER (not admin) via their own Agents panel -- distinct from a
  // regular unrestricted client login. An agent's dashboard is a
  // separate cut-down "Agent Console" (see AgentConsole.tsx), not the
  // normal client dashboard: only their assigned chats are actionable,
  // though they can read teammates' chats too and see who's online.
  isAgent      Boolean   @default(false)
  // Self-reported presence, toggled from the Agent Console -- used by
  // auto-assignment (see ConversationService.requestHandoff) to pick a
  // least-busy ONLINE agent, and shown to teammates as a roster.
  online       Boolean   @default(false)

  // Optional org/department/team membership -- see Team's own comment.
  // Purely additive: an account with no team behaves EXACTLY as before
  // (allowedPanels null/array resolves the same way it always did).
  // Only an account actually assigned to a team gains the extra
  // fallback tier (team default, checked when the account's own
  // allowedPanels is null).
  teamId       String?

  sessions     ClientSession[]

  @@index([businessId])
  @@index([teamId])
}

// One hierarchy primitive for "org / department / team" rather than
// three separate models -- structurally each level is the same thing
// (a named group of accounts with shared default panel access), just
// nested: a team with no parent reads as the top-level "org", a team
// with a parent reads as a "department" under it, and so on as deep as
// a business actually wants to go. defaultAllowedPanels is consulted
// ONLY as a fallback when a ClientAccount has no allowedPanels of its
// own set (null) -- an account's own explicit allow-list always wins,
// same precedence order CLAUDE.md's "the user's own words beat
// everything else" convention uses elsewhere in this app.
model Team {
  id                   String   @id @default(cuid())
  businessId           String
  name                 String
  parentTeamId         String?
  defaultAllowedPanels Json?

  createdAt            DateTime @default(now())

  @@index([businessId])
  @@index([parentTeamId])
}

// Per-business, per-role default panel list ("owner" | "staff") -- shown
// as the two editable presets in Client Access. Copied into a new
// account's own allowedPanels ONCE at creation time (picking a role in
// the create-login dropdown), never live-linked -- editing a preset
// later doesn't retroactively change any account already created from
// it, only new ones going forward. Deliberately separate from Team
// (which IS live-linked via account.teamId) since that's a different,
// already-explicit choice for this feature.
model RolePreset {
  id            String   @id @default(cuid())
  businessId    String
  role          String
  allowedPanels Json?

  updatedAt     DateTime @updatedAt

  @@unique([businessId, role])
}

// Audit trail for a client login's account settings -- who did what
// and when: password resets, panel-restriction edits, restrict/
// re-enable. NEVER the password value itself (old or new, hashed or
// not) -- there's nothing to "view" for an existing password (scrypt
// is one-way by design), only a reset-and-log-it flow; `detail` is a
// human-readable summary of the OTHER kinds of changes (e.g. "12/19
// panels", "restricted"), never a secret. Plain string clientAccountId
// (not a relation) so the log outlives a deleted account, same
// convention as businessId elsewhere in this schema.
model AccountActivityLog {
  id              String   @id @default(cuid())
  clientAccountId String
  // "password" | "panels" | "disabled" | "enabled" | "created"
  action          String
  detail          String?
  changedBy       String
  changedAt       DateTime @default(now())

  @@index([clientAccountId])
}

// Disabling or deleting the owning ClientAccount deletes these too
// (cascade), which is what makes "restrict" kick out an already-logged-in
// session immediately rather than waiting for it to expire.
model ClientSession {
  id              String   @id @default(cuid())
  token           String   @unique
  clientAccountId String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  account         ClientAccount @relation(fields: [clientAccountId], references: [id], onDelete: Cascade)

  @@index([clientAccountId])
}

// One live row per business, not versioned like AiConfigVersion — a
// widget's look has no audit/history need the way prompt changes do,
// so a plain upsert-by-businessId is the right-sized fit here. widget.js
// fetches this by businessId at load time, so every option here is
// truly plug-and-play: the embed snippet never changes when a client
// tweaks colors/copy from the dashboard, only this row does.
model WidgetConfig {
  id            String   @id @default(cuid())
  businessId    String   @unique

  accentColor   String   @default("#2563eb")
  position      String   @default("bottom-right") // "bottom-right" | "bottom-left"
  theme         String   @default("light") // "light" | "dark"
  launcherText  String   @default("Chat")
  headerText    String   @default("Chat with us")
  greeting      String   @default("Hi! How can I help you today?")
  avatarUrl     String?
  showBranding  Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Original ingested text for an uploaded file, persisted separately from
// its (post-chunking, fragmented) VectorRecord rows — without this, the
// scheduled knowledge-refresh job would have nothing to re-run
// extraction against, since UPLOAD_DIR is an ephemeral tmp path (see
// apps/web/lib/paths.ts) that doesn't survive past the upload request on
// Vercel. tabularHeaders/tabularRows are set only for a real CSV/XLSX
// upload — deterministic source, re-serialize directly on refresh
// instead of paying for another LLM extraction call.
model UploadedDocument {
  id               String    @id @default(cuid())
  businessId       String
  originalFilename String
  rawText          String
  tabularHeaders   Json?
  tabularRows      Json?

  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())

  @@unique([businessId, originalFilename])
}

// One consolidated CSV per business — a sectioned concatenation of every
// tabular chunk's own table (own headers per source; a single forced
// rectangular schema across heterogeneous sources was considered and
// rejected, see MasterCsvService). Rebuilt by the scheduled knowledge
// refresh job, not on every chat message — live chat keeps reading
// current chunks in real time regardless; this is a human-viewable/
// downloadable snapshot, not a retrieval data path.
model MasterCsv {
  businessId String   @id
  content    String
  updatedAt  DateTime @updatedAt
}

// Per-business "run the knowledge refresh at this Dhaka-time hour"
// setting — same single-mutable-row-per-business shape as WidgetConfig,
// not versioned like AiConfigVersion (a schedule time has no need for a
// change history).
model KnowledgeRefreshSchedule {
  businessId String    @id
  hourBd     Int
  lastRunAt  DateTime?
  // True for the span between "every crawl target is done/embedded" and
  // "the master CSV row has been rebuilt" — the one refresh phase that
  // has no CrawlTarget row of its own to report status from.
  buildingCsv Boolean  @default(false)
  // Lets auto-heal tell "still actively building" from "died mid-build and
  // will stay true forever" (same STUCK_CRAWLING_MS reasoning as
  // CrawlTarget's stuck "crawling"/"embedding" detection).
  updatedAt   DateTime @default(now()) @updatedAt
}

// One row per real product, per business — the structured browse-catalog
// counterpart to the chat-retrieval chunks (VectorRecord) and the
// human-readable export (MasterCsv). Same underlying crawl/extraction
// pipeline feeds all three; this table exists because neither of the
// other two is queryable as "every product in this category" without an
// LLM call and a token budget in the way — a catalog UI needs a real
// list it can page/filter directly. sourceUrl is the crawled product
// page's own URL (or a synthetic key for an uploaded-document product)
// — the stable identity a re-crawl upserts against, same "stable key,
// re-run replaces" pattern as UploadedDocument/CrawledPage. price/stock
// are kept as free text, not Decimal/Int/enum: source sites format
// these inconsistently (ranges, "Call for price", "In stock" vs a
// count), and forcing a strict type would drop real data rather than
// normalize it.
model Product {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  price       String?
  // Unit cost price -- what the business pays, separate from `price`
  // (what it sells for). Same free-text-not-numeric convention as
  // `price`/`stock` since this model deliberately never enforces a
  // number format on money fields.
  costPrice   String?
  // "regular" | "premium" -- inventory tier, admin-set per item.
  tier        String   @default("regular")
  description String?
  stock       String?
  category    String?
  minStock    Int      @default(0)
  imageUrl    String?
  sourceUrl   String?
  sku         String?
  // Vision-model-generated visual description + any legible text read
  // from imageUrl (see VisionService) — indexed as its own searchable
  // chunk (documentId "product-image:{id}") so a customer's own photo
  // can match this product via the same text-retrieval pipeline, no
  // separate image-similarity index needed. Null until captioned
  // (ProductSyncService fires this automatically when imageUrl is set
  // on create/update; re-crawls with an unchanged imageUrl don't
  // recaption).
  imageCaption String?

  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([businessId, sourceUrl])
  @@index([businessId])
}

// One row per order the AI takes directly inside a chat conversation
// (any channel — website/WhatsApp/Messenger/Instagram all funnel through
// the same ChatService). The AI collects all 5 fields conversationally,
// then emits a structured [[ORDER_TAKEN:{...}]] marker (same pattern as
// HANDOFF_MARKER — see chat-service.ts) that gets parsed out of its reply
// and turned into this row; the customer never sees the marker itself.
// Free-text fields throughout, not normalized (a real phone/address
// validator is a different feature, not requested here) — this is a
// human-readable order slip for a staff member to act on, not a
// fulfillment system of record.
model Order {
  id              String   @id @default(cuid())
  businessId      String
  conversationId  String

  customerName    String
  phone           String
  // Nullable -- the AI order-taking chat flow doesn't collect an email
  // today, so this starts empty and is filled in by staff by hand (see
  // OrderService.UpdateDeliveryInput.email) until/unless that changes.
  email           String?
  deliveryAddress String
  products        String
  paymentMethod   String

  // Manual delivery tracking — no live courier API wired yet (needs a
  // merchant account/credentials from a provider like Pathao/Steadfast
  // first, see OrderService.updateDelivery's own comment for the
  // adapter seam left for that). courier/trackingId are free text a
  // staff member fills in by hand; deliveryStatus is a plain string,
  // same "tweakable without a migration" convention as
  // RepairAppointment.status.
  courier         String?
  trackingId      String?
  deliveryStatus  String   @default("pending")

  orderTags       OrderTag[]

  createdAt       DateTime @default(now())

  @@index([businessId, createdAt])
}

// Order-level tagging — same shape as ConversationTag/MessageTag
// (shared Tag catalog, "ai" vs "manual" source), added so an order can
// be labeled (e.g. "VIP", "Refund requested") independently of the
// conversation it came from.
model OrderTag {
  id        String   @id @default(cuid())
  orderId   String
  tagId     String
  source    String   // "ai" | "manual" -- always "manual" today, kept for symmetry with the other two tag-assignment tables

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([orderId, tagId])
  @@index([tagId])
}

// A repair-shop client's appointment booking + tracking record — same
// "flat, human-readable slip" philosophy as Order above, not a
// fulfillment system of record. `trackingToken` doubles as the id of
// the linked Conversation (see RepairController) so the existing
// generic messaging endpoints (/api/chat/messages, /api/admin/handoffs/
// reply) work for the tracking page's "contact us" thread with zero new
// messaging code — this business has no AI bot at all, so that
// Conversation goes straight to a human handoff at creation time.
model RepairAppointment {
  id               String   @id @default(cuid())
  businessId       String
  trackingToken    String   @unique

  customerName     String
  phone            String
  email            String?
  deviceType       String
  deviceModel      String?
  issueDescription String
  appointmentDate  DateTime

  // booked | received | in_repair | ready | completed | cancelled — a
  // plain string, not a Prisma enum, so the workflow can be tweaked
  // later without a migration (same convention as Conversation.channel).
  status           String   @default("booked")

  // Priority: low, normal, high, urgent
  priority         String   @default("normal")

  // Assigned technician (references Staff model)
  technicianId     String?

  // Device photos uploaded by customer or staff
  deviceImages     String[] @default([])

  // Reschedule request from customer
  rescheduleRequested  Boolean @default(false)
  rescheduleNewDate    DateTime?

  // Cancellation request from customer
  cancelRequested  Boolean @default(false)
  cancelReason     String?

  // Cost tracking
  estimatedCost    Float?
  actualCost       Float?

  // Warranty set on completion
  warrantyExpiry   DateTime?

  // Order Management billing layer -- this same row IS an "order
  // management" entry once it has a serial number/items; not a separate
  // model (see RepairOrderItem's own comment for why).
  serialNumber     String?
  // Nullable FK to Contact so CLV/issue-history rolls up via a real
  // relation instead of the phone-matching ContactService.getRecord
  // otherwise falls back to.
  contactId        String?
  contact          Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items            RepairOrderItem[]
  invoices         Invoice[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([businessId, appointmentDate])
  @@index([businessId, status])
}

// A part or service line on a RepairAppointment's Order Management
// billing layer -- same itemized shape as QuoteItem/InvoiceItem so
// generating a real Invoice from these is a straight copy, not a new
// pricing model. `productId` set (kind="part") means adding/removing
// this item also adjusts that Product's live stock (see
// RepairAppointmentService.addItem/removeItem) -- direct adjustment, no
// reservation/hold system.
model RepairOrderItem {
  id                  String   @id @default(cuid())
  repairAppointmentId String
  productId           String?
  kind                String   // "part" | "service"
  name                String
  quantity            Float    @default(1)
  defaultPrice        Float
  overridePrice       Float?

  repairAppointment RepairAppointment @relation(fields: [repairAppointmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([repairAppointmentId])
}

model Staff {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  email       String?
  phone       String?
  role        String   @default("technician") // technician | manager
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
}

// Per-business outbound-email sender identity — same "single mutable
// row per business" shape as WidgetConfig, not a versioned/history
// model like AiConfigVersion, since this is simple contact info with
// no change log needed. `fromEmail`'s domain must be DNS-verified in
// Resend before sending from it actually works (a one-time manual step
// per client, not something code can automate) — ResendEmailClient
// fails gracefully rather than blocking whatever triggered the send.
model EmailSenderConfig {
  id              String   @id @default(cuid())
  businessId      String   @unique
  fromName        String
  fromEmail       String
  trackingPageUrl String?
  updatedAt       DateTime @updatedAt
}

// Per-business Gmail sender, connected via an App Password (Google
// Account -> Security -> App Passwords, needs 2-Step Verification on)
// instead of OAuth -- no Google Cloud project, no consent screen, no
// platform-wide app credential, nothing shared across clients. Sent
// over Gmail's own SMTP (smtp.gmail.com:465) by GmailEmailClient.
model GmailSenderConfig {
  id          String   @id @default(cuid())
  businessId  String   @unique
  gmailAddress String
  appPassword String
  updatedAt   DateTime @updatedAt
}

// One editable email template per (business, kind, status) -- kind is
// "order_status" or "repair_status", statusValue matches
// DELIVERY_STATUSES / the repair status list. Rendered with {{placeholder}}
// tokens (see renderTemplate in packages/email) and sent through the
// business's own connected Gmail account (GmailEmailClient), not through
// the paid Resend path EmailSenderConfig backs.
model StatusEmailTemplate {
  id          String   @id @default(cuid())
  businessId  String
  kind        String
  statusValue String
  subject     String
  bodyHtml    String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([businessId, kind, statusValue])
  @@index([businessId])
}

// CRM layer (Contacts/Companies) — a real customer record instead
// of the per-conversation name lookups ConversationService.
// namesForConversations already does across Order/RepairAppointment.
// Dedup happens in CrmService.upsertContact, scoped per business: a
// normalized phone or lowercased email match merges into the same
// Contact rather than creating a new one every time that customer
// orders/books again.
model Contact {
  id            String   @id @default(cuid())
  businessId    String
  name          String
  phone         String?
  email         String?
  // The organization this contact works for, if any -- plain fields
  // instead of a separate Company entity/relation. Companies used to be
  // their own model+panel, but carried nothing beyond a name and a
  // domain and nothing else in the app ever referenced a companyId
  // directly (not Quote, not Invoice -- all key off Contact),
  // so the extra table/join bought nothing a Contact couldn't hold
  // itself.
  companyName   String?
  companyDomain String?

  quotes     Quote[]
  invoices   Invoice[]
  repairAppointments RepairAppointment[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, phone])
  @@index([businessId, email])
}

// Per-business admin-only "remove this box" toggle — hovering any
// removable widget (see RemovableSection.tsx) in the admin's own view
// of a client's dashboard shows a minus button; clicking it adds a row
// here. A real client login (restricted, non-admin session) never
// renders a widget whose id has a row here; the admin still sees it
// (dimmed, with a restore "+") so it can be brought back. widgetId is a
// stable dotted string the widget itself owns (e.g.
// "reports.delivery") — not a DB id, so it survives that record being
// recreated.
model HiddenWidget {
  id         String   @id @default(cuid())
  businessId String
  widgetId   String

  createdAt  DateTime @default(now())

  @@unique([businessId, widgetId])
  @@index([businessId])
}

// Revenue layer (Quote -> Invoice -> Payment), built on the same
// Contact records as the rest of the CRM instead of a separate billing
// database. A Quote is a proposal; accepting it turns it into an
// Invoice (InvoiceService.generateFromQuote copies the line items, not
// a live reference — a quote can keep changing after an invoice already
// exists off an earlier version). Money fields are Float.
model Quote {
  id         String   @id @default(cuid())
  businessId String
  contactId  String?
  title      String
  // draft | sent | accepted | rejected | expired
  status     String   @default("draft")
  currency   String   @default("BDT")
  discount   Float    @default(0)
  tax        Float    @default(0)
  notes      String?
  expiresAt  DateTime?

  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items      QuoteItem[]
  invoices   Invoice[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, status])
}

model QuoteItem {
  id        String  @id @default(cuid())
  quoteId   String
  name      String
  quantity  Float   @default(1)
  unitPrice Float

  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Invoice {
  id            String    @id @default(cuid())
  businessId    String
  contactId     String?
  quoteId       String?
  // Set when this invoice was generated from a RepairAppointment's Order
  // Management items -- lets the Invoices panel join back for
  // device/issue context, same pattern as quoteId.
  repairAppointmentId String?
  // Short, human-readable per-business sequence (e.g. "INV-0007"), not
  // the cuid id — same "simple worded short" convention the tracking
  // tokens/order IDs already follow elsewhere in this dashboard.
  invoiceNumber String
  // draft | issued | partially_paid | paid | overdue | void
  status        String    @default("draft")
  currency      String    @default("BDT")
  discount      Float     @default(0)
  tax           Float     @default(0)
  amountPaid    Float     @default(0)
  issueDate     DateTime  @default(now())
  dueDate       DateTime?

  contact       Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  quote         Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  repairAppointment RepairAppointment? @relation(fields: [repairAppointmentId], references: [id], onDelete: SetNull)
  items         InvoiceItem[]
  payments      Payment[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([businessId, status])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  name      String
  quantity  Float   @default(1)
  unitPrice Float

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// A recorded payment against an invoice — manual entry (cash/bank
// transfer/mobile banking reference) rather than a live payment-gateway
// integration. method is free text on purpose: this platform's real
// clients settle via bKash/Nagad/bank transfer references, not a card
// processor — wiring a real gateway (Stripe/SSLCommerz) is a distinct
// follow-up that needs its own credentials, not something to fake here.
model Payment {
  id         String   @id @default(cuid())
  businessId String
  invoiceId  String
  amount     Float
  currency   String   @default("BDT")
  method     String
  note       String?
  paidAt     DateTime @default(now())

  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([invoiceId])
}
// Generic approval engine (Day 1 PM) -- built once, reused by every
// later module that needs sign-off (CPQ, Procurement, Finance) instead
// of each inventing its own approve/reject flow. This engine doesn't
// know what a "Quote" or "PurchaseOrder" is -- type+recordId is the
// CALLER's own pointer back to whatever needs approving; this table
// only tracks the approval workflow itself.
model ApprovalRequest {
  id          String   @id @default(cuid())
  businessId  String
  type        String
  recordId    String
  requestedBy String
  // pending | approved | rejected -- plain string, not an enum, so a
  // future status doesn't need a migration (same convention as
  // RepairAppointment.status elsewhere in this schema).
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  decidedAt   DateTime?

  steps       ApprovalStep[]

  @@index([businessId])
  @@index([type, recordId])
  @@index([businessId, status])
}

// order groups steps into sequential stages -- every step in the same
// order number runs in PARALLEL (all must approve before that stage
// passes); the next order number's steps aren't even decidable until
// every step in the prior order is approved. A single-step, single-
// order request is just a plain one-person approval, the common case.
model ApprovalStep {
  id                String    @id @default(cuid())
  requestId         String
  order             Int
  status            String    @default("pending")
  // Either a specific person must decide (approverAccountId) or anyone
  // matching a role can (approverRole, e.g. "isAdmin") -- exactly one
  // of these is set, enforced in ApprovalService, not here.
  approverAccountId String?
  approverRole      String?
  decidedBy         String?
  decidedAt         DateTime?
  comment           String?

  request           ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}
